    "fuck", "shit", "bitch", "dick", "pussy", "sex", "kill", "nigger", "nigga", "porn",
    "せっくす", "えろ", "おっぱい", "れいぷ", "ちかん", "ころせ", "きちがい", "がいじ", "しょうがい"
  ]
